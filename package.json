{
  "name": "saga-mcp",
  "mcpName": "io.github.spranab/saga-mcp",
  "version": "1.19.0",
  "description": "Your agent loses the plan between sessions, so saga-mcp gives it a SQLite-backed tracker for projects, epics, tasks, subtasks, dependencies, and notes: 41 MCP tools, an activity log, and a one-call dashboard, with no accounts and no external services.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "saga-mcp": "dist/index.js",
    "saga-web": "dist/web/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "manifest.json",
    "glama.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "web": "tsc && node dist/web/index.js",
    "dev": "tsc && node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test",
    "test:only": "node --test",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo-gif": "node scripts/mcp-demo.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "project-tracker",
    "project-management",
    "task-manager",
    "task-tracker",
    "issue-tracker",
    "claude",
    "claude-code",
    "ai-agent",
    "ai-agents",
    "agent-tools",
    "sqlite",
    "jira-alternative",
    "llm-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spranab/saga-mcp.git"
  },
  "homepage": "https://github.com/spranab/saga-mcp#readme",
  "bugs": {
    "url": "https://github.com/spranab/saga-mcp/issues"
  },
  "author": "spranab",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "types": "./dist/index.d.ts",
  "directories": {
    "test": "test"
  }
}
